# Django
SECRET_KEY=generate-a-strong-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Database (leave empty for SQLite default; configure for PostgreSQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/catopia_cafe

# Xendit Payment Gateway (Backend only — never expose to frontend)
# Test keys start with xnd_development_ ; Live keys start with xnd_production_
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_verification_token

# Mapbox Public Token (Required for cafe info endpoint / directions)
MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token_here

# Cafe Settings (Defaults configured in config/settings.py)
CAFE_NAME=Catopia Café
CAFE_ADDRESS=89-G Barlin St, Sta. Cruz, Naga City, 4400 Camarines Sur
CAFE_PHONE=09123456789
CAFE_EMAIL=catopia.cafe@gmail.com
CAFE_LATITUDE=13.627225580837424
CAFE_LONGITUDE=123.18631853657558
CAFE_OPENING_HOUR=10
CAFE_CLOSING_HOUR=21
CATROOM_HOURLY_RATE=300
CATROOM_MAX_VISITORS=10
CATROOM_MIN_DEPOSIT=150
CATROOM_HOLD_MINUTES=15
CATROOM_CANCEL_CUTOFF_HOURS=24

# Frontend URL
FRONTEND_BASE_URL=http://localhost:5173
LOYALTY_POINTS_PER_PESO=10

# Resend Email API (For sending customer payment receipts)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Catopia Café <receipts@yourdomain.com>
