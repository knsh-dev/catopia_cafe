# Backend API Base URL (leave empty if using Vite dev server proxy to localhost:8000)
VITE_API_URL=

# Mapbox Public Access Token (must begin with pk.)
# For production, create a URL-restricted token in your Mapbox account
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Mapbox Map Style URL
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
